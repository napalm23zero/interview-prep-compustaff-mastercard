{
  "version": "0.2.0",
  "configurations": [
    {
      // DEBUG=release leaks out of the VS Code Server process into everything it spawns
      // (not ours, not in the Dockerfile) — Spring Boot binds that env var to the `debug`
      // property, which turns on the CONDITIONS EVALUATION REPORT. Overridden here.
      "type": "java",
      "name": "backend: debug",
      "request": "launch",
      "mainClass": "dev.hustletech.interview.compustaff.CompustaffApplication",
      "projectName": "compustaff",
      "console": "internalConsole",
      // Without this, a forgotten `mvn spring-boot:run` makes the debug session die with
      // "Port 8080 was already in use" — an error that points at the wrong place.
      "preLaunchTask": "backend: free :8080",
      "env": { "DEBUG": "false" }
    },
    {
      // Attaches to a process already started with:
      // mvn spring-boot:run -Dspring-boot.run.jvmArguments="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"
      "type": "java",
      "name": "backend: attach (5005)",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005
    },
    {
      // Starts the Vite dev server under F5. This debugs the *server process*, not the
      // React code in the browser: Chrome runs on the host, outside the container, so a
      // `chrome`-type launch has no browser to open here. Breakpoints in components are
      // set in the host browser's DevTools (source maps are on by default in Vite dev).
      "type": "node-terminal",
      "name": "frontend: dev (vite)",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/app/frontend"
    }
  ],
  "compounds": [
    {
      // One F5 for the whole stack: Spring Boot under the Java debugger + Vite dev server.
      "name": "full stack: backend + frontend",
      "configurations": ["backend: debug", "frontend: dev (vite)"],
      "stopAll": true
    }
  ]
}
