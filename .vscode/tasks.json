{
  "version": "2.0.0",
  // Uses the global `mvn` (3.9.9 in the devcontainer) instead of `./mvnw`: the wrapper
  // only exists after the scaffold is generated, `mvn` works from the start.
  "tasks": [
    {
      "label": "backend: test",
      "detail": "mvn test — the first command of any session",
      "type": "shell",
      "command": "mvn -q test",
      "options": { "cwd": "${workspaceFolder}/app/backend" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "panel": "dedicated", "clear": true, "group": "check" },
      "problemMatcher": []
    },
    {
      "label": "backend: build",
      "detail": "mvn package without tests",
      "type": "shell",
      "command": "mvn -q -DskipTests package",
      "options": { "cwd": "${workspaceFolder}/app/backend" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "dedicated", "clear": true, "group": "check" },
      "problemMatcher": []
    },
    {
      // Kills whatever holds :8080 before starting. `-sTCP:LISTEN` narrows it to the
      // process owning the port — without it lsof would also match client connections
      // to :8080 and kill, for example, a curl in flight.
      // `xargs -r` runs nothing when the port is already free; the trailing `exit 0`
      // keeps the task from ever failing and blocking whatever depends on it.
      "label": "backend: free :8080",
      "detail": "kills whatever is holding port 8080",
      "type": "shell",
      "command": "lsof -ti tcp:8080 -sTCP:LISTEN | xargs -r kill -9 2>/dev/null; for i in $(seq 1 10); do lsof -ti tcp:8080 -sTCP:LISTEN >/dev/null 2>&1 || break; sleep 0.3; done; exit 0",
      "presentation": { "reveal": "silent", "panel": "shared", "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "backend: run",
      "detail": "Spring Boot on :8080",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/app/backend" },
      "dependsOn": ["backend: free :8080"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/app/frontend" },
      "presentation": { "panel": "dedicated", "clear": true, "group": "check" },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "detail": "Vite on :5173",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/app/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "frontend: typecheck",
      "detail": "tsc --noEmit — catches what the Vite dev server does not",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "options": { "cwd": "${workspaceFolder}/app/frontend" },
      "presentation": { "panel": "dedicated", "clear": true, "group": "check" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/app/frontend" },
      "presentation": { "panel": "dedicated", "clear": true, "group": "check" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "dev: all",
      "detail": "brings backend and frontend up side by side",
      "dependsOn": ["backend: run", "frontend: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "check: all",
      "detail": "what to run before calling anything done",
      "dependsOn": ["backend: test", "frontend: typecheck"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
