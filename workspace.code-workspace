{
  "folders": [
    {
      "name": "interview-prep-compustaff-mastercard",
      "path": "."
    }
  ],

  "settings": {
    // permanent reminder that this is the mock, not the real assessment
    "window.title": "interview-prep-compustaff-mastercard",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "terminal.integrated.scrollback": 20000,
    // group satellite files under their main file in the explorer
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "package.json": "package-lock.json, .npmrc, .nvmrc, tsconfig*.json, vite.config.*, eslint.config.*, .eslintrc*, index.html",
      "pom.xml": "mvnw, mvnw.cmd, .mvn, HELP.md"
    },
    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": true,
    // debug opens in the panel without stealing focus from the editor
    "debug.openDebug": "neverOpen",
    "debug.internalConsoleOptions": "openOnSessionStart",
    "debug.toolBarLocation": "commandCenter",
    // with two servers running, the terminal has to stay navigable
    "workbench.editor.enablePreview": false,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 12,
    // never commit anything by accident: the training repo is not a deliverable
    "git.confirmSync": true,
    "git.enableSmartCommit": false,
    "workbench.colorCustomizations": {
      "activityBar.background": "#1e4528",
      "titleBar.activeBackground": "#1e4528",
      "titleBar.activeForeground": "#FFF9FF",
      "titleBar.inactiveBackground": "#1e4528",
      "titleBar.inactiveForeground": "#FFF9FF",
      "statusBar.background": "#1e4528",
      "statusBar.foreground": "#FFF9FF",
      "statusBar.debuggingBackground": "#1e4528",
      "statusBar.debuggingForeground": "#FFF9FF",
      "statusBar.noFolderBackground": "#1e4528",
      "statusBar.noFolderForeground": "#FFF9FF"
    }
  }
}
